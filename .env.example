# Google Drive API設定
# Google Cloud Consoleで取得した認証情報ファイル名
DRIVE_CREDENTIALS_FILE=credentials.json

# 監視するGoogle DriveフォルダのID（空の場合は全体を監視）
# フォルダのURLから取得: https://drive.google.com/drive/folders/FOLDER_ID
DRIVE_FOLDER_ID=

# Anthropic Claude API設定
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LINE Messaging API設定
# https://developers.line.biz/ で取得
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LINEユーザーIDまたはグループID
# LINE Official Account ManagerのMessaging API設定で確認可能
LINE_USER_ID=your_line_user_id_here

# 監視設定
# ポーリング間隔（秒） デフォルト: 300秒（5分）
# main.pyで使用（Docker、systemd等）
POLL_INTERVAL=300

# Vercel/サーバーレス用: チェック対象期間（分）デフォルト: 10分
# 前回チェックからの経過時間を基準に新しいファイルを検出
CHECK_INTERVAL_MINUTES=10

# 処理する最大ファイルサイズ（バイト） デフォルト: 10485760（10MB）
MAX_FILE_SIZE=10485760

# LLMサマリー設定
# サマリー対象の最大文字数 デフォルト: 5000
SUMMARY_MAX_LENGTH=5000

# クラウドデプロイ用（オプション）
# ローカルで認証後、以下のコマンドで取得してクラウドの環境変数に設定
# cat credentials.json | base64
# cat token.pickle | base64
GOOGLE_CREDENTIALS_BASE64=
GOOGLE_TOKEN_BASE64=
